/*--------------------------------*- C++ -*----------------------------------*\
  airway-aerosol-delivery : reusable AIRFLOW base case (OpenFOAM v2406)
  Case-specific values come from system/caseParameters (written by
  scripts/generate_airflow_cases.py from config/experiment.yaml).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}

#include "caseParameters"
scale 1;
vertices
(
    ($xmin $ymin $zmin) ($xmax $ymin $zmin) ($xmax $ymax $zmin) ($xmin $ymax $zmin)
    ($xmin $ymin $zmax) ($xmax $ymin $zmax) ($xmax $ymax $zmax) ($xmin $ymax $zmax)
);
blocks ( hex (0 1 2 3 4 5 6 7) ($nx $ny $nz) simpleGrading (1 1 1) );
boundary
(
    background { type patch; faces ((0 3 2 1) (4 5 6 7) (0 1 5 4) (1 2 6 5) (2 3 7 6) (3 0 4 7)); }
);
