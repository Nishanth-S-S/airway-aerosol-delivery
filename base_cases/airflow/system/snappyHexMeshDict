/*--------------------------------*- C++ -*----------------------------------*\
  airway-aerosol-delivery : reusable AIRFLOW base case (OpenFOAM v2406)
  Case-specific values come from system/caseParameters (written by
  scripts/generate_airflow_cases.py from config/experiment.yaml).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}

#include "caseParameters"
castellatedMesh true;
snap            true;
addLayers       $addLayers;

geometry
{
    airway.stl
    {
        type triSurfaceMesh;
        name airway;
        regions
        {
            inlet            { name inlet; }
            targetOutlet     { name targetOutlet; }
            comparisonOutlet { name comparisonOutlet; }
            walls            { name walls; }
        }
    }
}

castellatedMeshControls
{
    maxLocalCells       5000000;
    maxGlobalCells      20000000;
    minRefinementCells  0;
    maxLoadUnbalance    0.10;
    nCellsBetweenLevels 3;
    features ( { file "airway.eMesh"; level $featureLevel; } );
    refinementSurfaces
    {
        airway
        {
            level ($surfMin $surfMax);
            regions
            {
                inlet            { level ($surfMin $surfMin); patchInfo { type patch; } }
                targetOutlet     { level ($surfMin $surfMin); patchInfo { type patch; } }
                comparisonOutlet { level ($surfMin $surfMin); patchInfo { type patch; } }
                walls            { level ($surfMin $surfMax); patchInfo { type wall; } }
            }
        }
    }
    resolveFeatureAngle 30;
    refinementRegions
    {
        airway { mode inside; levels ((1e15 $insideLevel)); }
    }
    locationInMesh $locationInMesh;
    allowFreeStandingZoneFaces true;
}

snapControls
{
    nSmoothPatch 3;
    tolerance 2.0;
    nSolveIter 100;
    nRelaxIter 5;
    nFeatureSnapIter 15;
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap true;
}

addLayersControls
{
    relativeSizes true;
    layers { walls { nSurfaceLayers $nLayers; } }
    expansionRatio 1.2;
    finalLayerThickness 0.5;
    minThickness 0.1;
    nGrow 0;
    featureAngle 130;
    slipFeatureAngle 30;
    nRelaxIter 5;
    nSmoothSurfaceNormals 1;
    nSmoothNormals 3;
    nSmoothThickness 10;
    maxFaceThicknessRatio 0.5;
    maxThicknessToMedialRatio 0.3;
    minMedialAxisAngle 90;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
}

meshQualityControls
{
    #include "meshQualityDict"
}

mergeTolerance 1e-6;
