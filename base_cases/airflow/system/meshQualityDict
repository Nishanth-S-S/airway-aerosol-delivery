/*--------------------------------*- C++ -*----------------------------------*\
  airway-aerosol-delivery : reusable AIRFLOW base case (OpenFOAM v2406)
  Case-specific values come from system/caseParameters (written by
  scripts/generate_airflow_cases.py from config/experiment.yaml).
\*---------------------------------------------------------------------------*/
FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      meshQualityDict;
}

maxNonOrtho 65;
maxBoundarySkewness 3.5;   // kept below the checkMesh gate (4)
maxInternalSkewness 3.5;
maxConcave 80;
minVol 1e-30;
minTetQuality 1e-15;
minArea -1;
minTwist 0.02;
minDeterminant 0.001;
minFaceWeight 0.05;
minVolRatio 0.01;
minTriangleTwist -1;
nSmoothScale 4;
errorReduction 0.75;
relaxed { maxNonOrtho 75; }
