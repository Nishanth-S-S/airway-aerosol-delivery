FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      controlDict;
}

#include "../constant/particleParameters"
application     airwayParcelFoam;
startFrom       startTime;
startTime       0;
stopAt          endTime;
endTime         $endTime;
deltaT          $deltaT;
writeControl    runTime;
writeInterval   0.25;
purgeWrite      0;
writeFormat     ascii;
writePrecision  8;
timeFormat      general;
timePrecision   8;
runTimeModifiable false;
adjustTimeStep  no;
