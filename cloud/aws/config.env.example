# Copy to cloud/aws/config.env and edit. Read by every script in cloud/aws/.
REGION=eu-north-1                 # Stockholm: c7a.24xlarge Spot $0.93/h, interruption rate <5 % (checked 2026-11-07 01:18 UTC)
INSTANCE_TYPE=c7a.24xlarge        # 96 physical cores (no SMT), 192 GiB
MAX_PRICE=1.40                    # Spot price ceiling $/h: above this AWS stops the instance instead of charging more
BUDGET_USD=60                     # total project cap; 03_launch.sh refuses any launch that could exceed it
VOLUME_GB=400                     # gp3 working disk (deleted with the instance; all data are copied to S3)
BUCKET=airway-cfd-CHANGE-ME       # globally unique, private, encrypted (01_setup.sh creates it)
PROJECT_TAG=airway-cfd
ALERT_EMAIL=                      # your address for AWS Budgets alerts (50 / 80 / 100 % of BUDGET_USD); optional
